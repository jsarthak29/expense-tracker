# Copy to .env for local development. .env is gitignored; never commit real secrets.

# Any SQLAlchemy URL. This is what docker-compose points the app at.
DATABASE_URL=postgresql+psycopg://expenses:expenses@localhost:5432/expenses

# SQLite needs nothing installed and is what the test suite uses:
# DATABASE_URL=sqlite:///./expenses.db

# Load expenses.csv on startup when the table is empty (compose sets this).
# SEED_ON_STARTUP=false

# Credentials docker-compose hands to Postgres.
# POSTGRES_USER=expenses
# POSTGRES_PASSWORD=expenses
# POSTGRES_DB=expenses
